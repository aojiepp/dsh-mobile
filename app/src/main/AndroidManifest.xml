<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dsh.mobile">

    <!-- 自用分发工具：WebView 访问 DSH 服务；v2.0 起内置本机 Node 服务（前台服务保活） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- v2.5 收纳箱导出：targetSdk 28 走 legacy 存储模型，授权后可写 Download 目录 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- 安全基线（真机安全审计整改）：
         - debuggable 不写进真源：构建脚本按构建轨注入（debug 包加回、release 没有），
           真源里留 true 会让 release 忘摘时直接带调试口出厂。
         - allowBackup=false + dataExtractionRules：会话记录、API Key、带 token 的
           服务日志都在私有目录，不进云备份、不进换机迁移；
           API 31+ 由 rules 生效，旧机型由 allowBackup=false 兜底。
         - usesCleartextTraffic=true 保持不变：这是用户明确决策——「连接电脑」模式
           走局域网 http 直连，属接受风险项（本机内置服务模式全程回环，不受影响）。 -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|navigation|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/SettingsTheme"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ArtifactsActivity"
            android:exported="false"
            android:label="@string/artifacts_title"
            android:theme="@style/SettingsTheme"
            android:parentActivityName=".SettingsActivity" />

        <service
            android:name=".DshServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
